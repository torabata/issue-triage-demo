# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# ─── Devin v3 API credentials (from https://app.devin.ai/settings) ────
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEVIN_ORG_ID=org_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Devin org-level resource IDs ─────────────────────────────────────
# Two options:
#   (1) Run `python3 scripts/create_playbooks.py` + `scripts/create_knowledge.py`
#       once. They write `playbook_ids.json` / `knowledge_ids.json`, which the
#       orchestrator reads automatically. No need to set the vars below.
#   (2) Or set the vars directly here / in CI secrets:
# DEVIN_PLAYBOOK_ID=playbook-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEVIN_KNOWLEDGE_IDS=note-aaa...,note-bbb...,note-ccc...

# ─── GitHub credentials ───────────────────────────────────────────────
# Token requires: contents:write, issues:write, pull_requests:write
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=torabata/superset
